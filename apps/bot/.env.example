# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Случайная строка: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Telegram будет присылать её в заголовке каждого webhook-запроса
TELEGRAM_WEBHOOK_SECRET=change-me
# Общий секрет бота и API (то же значение, что в apps/api/.env)
BOT_API_SECRET=change-me-too
# Базовый адрес API (с /api на конце)
API_URL=http://localhost:8000/api
